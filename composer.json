{
  "name": "vanderlee/comprehend-laravel",
  "description": "Laravel validation rules for Comprehend grammars",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
    "vanderlee/comprehend": "^2.0"
  },
  "require-dev": {
    "illuminate/translation": "^11.0 || ^12.0 || ^13.0",
    "illuminate/validation": "^11.0 || ^12.0 || ^13.0",
    "phpunit/phpunit": "^10.5.62"
  },
  "autoload": {
    "psr-4": {"Vanderlee\\Comprehend\\Laravel\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Vanderlee\\Comprehend\\Laravel\\Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit --do-not-cache-result"
  }
}
